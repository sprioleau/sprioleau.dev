{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/(?:about|experience|work|contact|projects/all|privacy)?$",
      "methods": ["GET", "HEAD"],
      "continue": true,
      "transforms": [
        {
          "type": "response.headers",
          "op": "append",
          "target": { "key": "Vary" },
          "args": "Accept"
        }
      ]
    }
  ]
}
